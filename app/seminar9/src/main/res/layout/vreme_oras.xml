<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vreme_oras"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/edittext_oras"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/nume_oras"
        android:inputType="text" />

    <Spinner
        android:id="@+id/spinner_zile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:entries="@array/zile_optiuni" />

    <Button
        android:id="@+id/button_cauta_vremea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="getCodOras"
        android:text="@string/cauta_vremea" />

    <TextView
        android:id="@+id/textview_rezultat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textSize="16sp" />

</LinearLayout>